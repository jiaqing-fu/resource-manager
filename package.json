    "@tiptap/extension-image": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "antd": "6.6.8",
    "bcryptjs": "3.0.2",
    "docx": "9.15.1",
    "exceljs": "4.4.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.1.0",
    "next": "16.4.6",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
