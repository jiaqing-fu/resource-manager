# SQLite 数据库（相对于 prisma/schema.prisma）
DATABASE_URL="file:../data/app.db"

# 生产环境必须修改为至少 32 个字符的随机字符串
# 生成方式：openssl rand -base64 48
AUTH_SECRET="please-change-me-to-a-random-secret-of-at-least-32-chars"

# 仅 db:init 首次创建管理员时使用；留空则随机生成并打印一次
SEED_ADMIN_PASSWORD=""

# 服务监听
PORT=3000
HOSTNAME=0.0.0.0
TZ=Asia/Shanghai
NODE_ENV=production

# 仅在通过 HTTPS 访问时设为 1（内网 HTTP 保持 0 或留空）
COOKIE_SECURE=0

# 可选：备份目录与保留天数（默认 data/backups、30 天）
# BACKUP_DIR="data/backups"
# BACKUP_RETENTION_DAYS=30

# —— 通知邮件（SMTP）——
# 生产环境请填写真实 SMTP 参数，并把 .env 权限保持为 600；不要把密码提交到仓库。
SMTP_HOST=""
SMTP_PORT="465"
# 1=SSL/TLS（465），0=STARTTLS（587）；留空按端口推断
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# 发件地址，可写 "技术部 <notice@example.com>"；留空回退到 SMTP_USER
SMTP_FROM=""
SMTP_FROM_NAME=""
# 新建通知时预填的默认收件人，可空；多个地址用逗号分隔
NOTIFICATION_DEFAULT_TO=""
# Word 副本目录，必须位于持久化 data/ 下，不能放 /tmp
NOTIFICATION_STORAGE_DIR="data/notifications"
